#!/bin/bash

set -e

echo "Starting Rondev Command Center setup..."

# Rename main folders if they exist
[ -d "ENV VARIABLES" ] && mv "ENV VARIABLES" env-variables

# Rename docs folders if they exist
[ -d "docs/Ai workflows" ] && mv "docs/Ai workflows" docs/ai-workflows
[ -d "docs/Blogs" ] && mv "docs/Blogs" docs/blogs
[ -d "docs/Case Studies" ] && mv "docs/Case Studies" docs/case-studies
[ -d "docs/Demo" ] && mv "docs/Demo" docs/demo
[ -d "docs/Mantra" ] && mv "docs/Mantra" docs/mantra
[ -d "docs/Terminal shortcuts" ] && mv "docs/Terminal shortcuts" docs/terminal-shortcuts

# Rename prompts folders if they exist
[ -d "prompts/AI Refresher" ] && mv "prompts/AI Refresher" prompts/ai-refresher

# Rename files if they exist
[ -f "cheatsheets/terminal_cheatsheets.html" ] && mv "cheatsheets/terminal_cheatsheets.html" cheatsheets/terminal-cheatsheets.html
[ -f "generators/terminal_pro.html" ] && mv "generators/terminal_pro.html" generators/terminal-pro.html

# Create recommended folders
mkdir -p assets/images
mkdir -p cheatsheets
mkdir -p docker-lab/ollama
mkdir -p docker-lab/compose-files
mkdir -p docs/ai-workflows
mkdir -p docs/blogs
mkdir -p docs/case-studies
mkdir -p docs/demo
mkdir -p docs/mantra
mkdir -p docs/terminal-shortcuts
mkdir -p env-variables
mkdir -p generators
mkdir -p marketing/email-templates
mkdir -p marketing/landing-pages
mkdir -p marketing/ads
mkdir -p marketing/scripts
mkdir -p prompts/ai-refresher
mkdir -p prompts/blog-writer
mkdir -p prompts/landing-page-copy
mkdir -p prompts/case-study-generator
mkdir -p prompts/email-campaigns
mkdir -p repositories/ai-demo-engine
mkdir -p repositories/demos/vet-clinic-booking
mkdir -p repositories/demos/smart-barangay
mkdir -p repositories/demos/food-kiosk
mkdir -p repositories/demos/service-request-tracker
mkdir -p repositories/sites/rondev-main-site

# Create .gitignore
cat > .gitignore <<'EOF'
# Environment files
.env
.env.*
!.env.example
!*.example.env

# Secrets and credentials
*secret*
*secrets*
*password*
*credentials*
*token*
*.pem
*.key

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
.vercel/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temporary files
tmp/
temp/

# Local AI/model data
models/
ollama-data/
*.gguf
*.bin
EOF

# Create README.md
cat > README.md <<'EOF'
# Rondev Command Center

Central operations repository for **Rondev Software Development Services**.

This repository organizes Rondev's software demos, website content, AI workflows, marketing assets, email tools, documentation, and business development materials.

## Main Purpose

Rondev is building an AI-powered, demo-driven software marketing machine focused on practical business systems for local organizations and small businesses.

## Current Focus

The first active funnel is the **Veterinary Clinic Booking System**, designed to help clinics manage appointments, pet owner records, pet profiles, and daily scheduling workflows.

## Repository Structure

```text
assets/          Brand images, screenshots, and media files
cheatsheets/     Local technical references and terminal guides
docker-lab/      Docker, Ollama, and AI orchestration experiments
docs/            Blogs, case studies, demo guides, workflows, and internal notes
env-variables/   Environment variable templates only; no real secrets
generators/      Local content and utility generators
marketing/       Email sender, promotional assets, ad copy, and campaign materials
prompts/         AI prompt libraries for Rondev workflows
repositories/    Local project repositories, demo apps, and website code


/
Homepage

/demo
Demo hub

/demo/vet-clinic-booking
Veterinary clinic booking sales funnel

/blog
SEO articles and technical/business insights

/case-studies
Scenario-based and client-based case studies

/future-projects
Future SaaS concepts

/future-projects/transitpulse
Rondev TransitPulse concept page
